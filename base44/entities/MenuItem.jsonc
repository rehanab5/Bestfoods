{
  "name": "MenuItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "name_en": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "description_en": {
      "type": "string"
    },
    "price": {
      "type": "number"
    },
    "category": {
      "type": "string",
      "enum": [
        "kebab",
        "durum",
        "lahmacun",
        "pedrata",
        "plato",
        "boliviana",
        "pollo",
        "raciones"
      ]
    },
    "image": {
      "type": "string"
    },
    "is_deal": {
      "type": "boolean",
      "default": false
    },
    "badge": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "price"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}