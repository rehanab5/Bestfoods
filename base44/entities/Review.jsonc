{
  "name": "Review",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "author": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "location_name": {
      "type": "string"
    },
    "approved": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "description",
    "author",
    "rating"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}